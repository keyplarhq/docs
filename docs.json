              "concepts"
            ]
          },
          {
            "group": "Payment gateways",
            "pages": [
              "gateways/overview",
              "gateways/stripe",
              "gateways/lemon-squeezy",
              "gateways/polar"
            ]
          },
          {
            "group": "Catalog and benefits",
            "pages": [
              "catalog/products",
              "benefits/overview",
              "benefits/downloads",
              "benefits/license-keys",
              "benefits/github-access"
            ]
          },
          {
            "group": "Running your store",
            "pages": [
              "orders",
              "subscriptions",
              "customers",
              "licenses",
              "analytics"
            ]
          },
          {
            "group": "Migrating",
            "pages": [
              "import"
            ]
          },
          {
            "group": "Store settings",
            "pages": [
              "settings/store",
              "settings/custom-domain",
              "settings/team"
            ]
          },
          {
            "group": "Billing and data",
            "pages": [
              "billing",
              "customer-portal",
              "data-and-privacy"
            ]
          }
        ]
      },
      {
        "tab": "API reference",
        "groups": [
          {
            "group": "Introduction",
            "pages": [
              "api-reference/introduction"
            ]
          },
          {
            "group": "Licenses",
            "pages": [
              "api-reference/licenses/validate",
              "api-reference/licenses/activate",
              "api-reference/licenses/deactivate"
            ]
          }
        ]
      }
    ],
    "global": {
      "anchors": [
        {
          "anchor": "Dashboard",
          "href": "https://app.keyplar.com",
          "icon": "gauge"
        },
        {
          "anchor": "Website",
          "href": "https://keyplar.com",
          "icon": "globe"
        },
        {
          "anchor": "Support",
          "href": "mailto:support@keyplar.com",
          "icon": "envelope"
        }
      ]
    }
  },
  "logo": {
    "light": "/logo/light.svg",
    "dark": "/logo/dark.svg"
  },
  "navbar": {
    "links": [
      {
        "label": "Support",
        "href": "mailto:support@keyplar.com"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Dashboard",
      "href": "https://app.keyplar.com"
    }
  },
  "contextual": {
    "options": [
      "copy",
      "view",
      "chatgpt",
      "claude",
      "perplexity",
      "mcp",
      "cursor",
      "vscode"
    ]
